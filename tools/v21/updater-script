ui_print("LineageOS 17.1 REMASTERED V2.1");
ui_print("Checking Oppo A37 partitions and boot image...");
package_extract_dir("META-INF/scripts", "/tmp") || abort("Cannot extract installation scripts.");
package_extract_file("boot.img", "/tmp/boot.img") || abort("Cannot extract boot image.");
package_extract_file("boot.sha256", "/tmp/boot.sha256") || abort("Cannot extract boot checksum.");
set_metadata("/tmp/prepare.sh", "uid", 0, "gid", 0, "mode", 0755);
set_metadata("/tmp/flash_kernel.sh", "uid", 0, "gid", 0, "mode", 0755);
set_metadata("/tmp/cleanup-tuning.sh", "uid", 0, "gid", 0, "mode", 0755);
run_program("/tmp/prepare.sh") == 0 || abort("V2.1 checks failed; partitions were not written.");
show_progress(0.950000, 0);
ui_print("Writing system image...");
block_image_update("/dev/block/bootdevice/by-name/system", package_extract_file("system.transfer.list"), "system.new.dat.br", "system.patch.dat") || abort("E1001: System image update failed.");
ui_print("Writing and verifying kernel...");
run_program("/tmp/flash_kernel.sh") == 0 || abort("E1002: Kernel write or verification failed.");
set_progress(1.000000);
ui_print("V2.1 installed. You can reboot now.");
